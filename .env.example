# Copy to .env and fill in real values for local use.
# Never commit a real .env file.

# Modbus TCP slave bind address. Loopback by default — do not change to
# 0.0.0.0 unless you understand you are exposing an unauthenticated
# industrial protocol to your network.
MODBUS_BIND_HOST=127.0.0.1
MODBUS_BIND_PORT=5502

# Placeholder credentials for future HMI/historian components.
# Real values are generated per-deploy at runtime, never checked in.
HMI_ADMIN_USER=changeme
HMI_ADMIN_PASSWORD=changeme
POSTGRES_PASSWORD=changeme
