# Copy to .env and fill in real values for local use.
# Never commit a real .env file.

# Modbus TCP slave bind address. Loopback by default — do not change to
# 0.0.0.0 unless you understand you are exposing an unauthenticated
# industrial protocol to your network. Read by process_sim/server.py,
# sensor/tap.py, tools/modctl.py, and tools/hmi_poll.py — this is the
# only env var actually consumed anywhere in the loopback (M1) stack.
MODBUS_BIND_HOST=127.0.0.1
MODBUS_BIND_PORT=5502

# The docker-compose (M1.5+) stack doesn't use env-file credentials at
# all — HMI, historian, Postgres, and Grafana all use documented,
# simulated-environment default credentials set directly in
# docker-compose.yml (see SECURITY.md). Nothing to configure here for
# `make up`.
